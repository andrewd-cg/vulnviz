# syntax=docker/dockerfile:1
# Ingest job: static Go binary plus the default sources config.
ARG GO_IMAGE=cgr.dev/chainguard/go:latest-dev
ARG RUNTIME_IMAGE=cgr.dev/chainguard/static:latest

FROM ${GO_IMAGE} AS build
WORKDIR /src
# Go modules come from Chainguard Libraries. Pass a netrc with credentials for
# libraries.cgr.dev as the "netrc" build secret; CI writes it from
# `chainctl auth token --audience=libraries.cgr.dev`. go.sum still verifies
# every module. Override GOPROXY to build against another proxy.
ARG GOPROXY=https://libraries.cgr.dev/go
ARG GONOSUMDB=*
ARG GOFLAGS
COPY go.mod go.sum ./
RUN --mount=type=secret,id=netrc,mode=0444,required=true \
    NETRC=/run/secrets/netrc go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ingest ./cmd/ingest

FROM ${RUNTIME_IMAGE}
COPY --from=build /out/ingest /usr/bin/ingest
COPY configs/sources.yaml /etc/vulnviz/sources.yaml
ENV VULNVIZ_CONFIG=/etc/vulnviz/sources.yaml VULNVIZ_TEMP=/scratch
USER 65532:65532
ENTRYPOINT ["/usr/bin/ingest"]
CMD ["all"]
